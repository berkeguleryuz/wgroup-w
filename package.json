{
  "name": "businessflix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:users": "tsx scripts/seed-test-users.ts",
    "db:seed:demo": "tsx prisma/seed.ts && node scripts/wire-real-episodes.mjs && tsx scripts/seed-demo-extras.ts && tsx scripts/seed-test-users.ts && tsx scripts/seed-demo-full.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.100.14",
    "better-auth": "^1.6.23",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "next": "16.2.10",
    "next-intl": "^4.9.1",
    "ogl": "^1.0.11",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.0",
    "stripe": "^22.0.2",
    "swiper": "^12.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.19"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.13"
    }
  }
}
