generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  role            String?   @default("individual")
  banned          Boolean?  @default(false)
  banReason       String?
  banExpires      DateTime?

  sessions        Session[]
  accounts        Account[]
  memberships     Member[]
  sentInvitations Invitation[]   @relation("Inviter")

  progress                Progress[]
  individualSubscription  IndividualSubscription?
  instructorProfile       Instructor?
  agentConversations      AgentConversation[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy       String?
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  members     Member[]
  invitations Invitation[]
  departments Department[]

  companyProfile     CompanyProfile?
  titleAudience      TitleOrganization[]
  createdTitles      Title[]
  createdInstructors Instructor[]
  hiddenTitles       OrganizationHiddenTitle[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([departmentId])
  @@map("member")
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String

  members       Member[]
  titleAudience TitleDepartment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([inviterId])
  @@map("invitation")
}

enum Section {
  SERIES
  MOVIE
  TALENT
}

enum TitleType {
  SERIES
  MOVIE
}

enum TitleVisibility {
  PUBLIC // visible to every subscriber (default)
  ORG_ONLY // visible only to members of the assigned organizations (+ staff)
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     String
  titleEn   String?
  titleDe   String?
  section   Section
  parentId  String?
  parent    Category?  @relation("Sub", fields: [parentId], references: [id])
  children  Category[] @relation("Sub")
  sortOrder Int        @default(0)
  titles    Title[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section, parentId])
  @@index([parentId])
}

model Title {
  id           String    @id @default(cuid())
  slug         String    @unique
  type         TitleType
  title        String
  synopsis     String
  heroImageUrl String?
  trailerUrl   String?
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id])
  published    Boolean   @default(false)
  publishedAt  DateTime?
  // Scheduled publish: a cron promotes the title to published once this passes.
  scheduledFor DateTime?
  // Audience gate: PUBLIC (all subscribers) or ORG_ONLY (only assigned orgs).
  visibility   TitleVisibility @default(PUBLIC)
  // Set when a company created this title via its self-serve content studio.
  // Such titles are always ORG_ONLY and only editable by that org's owner
  // (platform staff can still manage them from the editor panel).
  createdByOrgId String?
  createdByOrg   Organization? @relation(fields: [createdByOrgId], references: [id], onDelete: SetNull)

  episodes           Episode[]
  credits            TitleInstructor[]
  orgAudience        TitleOrganization[]
  departmentAudience TitleDepartment[]
  hiddenBy           OrganizationHiddenTitle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, published])
  @@index([published, publishedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([published, scheduledFor])
  @@index([published, visibility])
  @@index([createdByOrgId])
}

// Which organizations an ORG_ONLY title is exposed to. No rows = visible to
// no one but staff (until orgs are assigned).
model TitleOrganization {
  titleId        String
  organizationId String
  title          Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([titleId, organizationId])
  @@index([organizationId])
}

// PUBLIC platform titles an org owner has hidden from their organization's
// members. Owners and staff still see the title; regular members of the org
// don't (catalog, search, watch pages).
model OrganizationHiddenTitle {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  titleId        String
  title          Title        @relation(fields: [titleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([organizationId, titleId])
  @@index([titleId])
}

// Optional department targeting for an ORG_ONLY title. No rows = the whole
// company sees it; with rows only members of those departments (and the org
// owner) see it.
model TitleDepartment {
  titleId      String
  departmentId String
  title        Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([titleId, departmentId])
  @@index([departmentId])
}

model Episode {
  id            String  @id @default(cuid())
  titleId       String
  title         Title   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  seasonNumber  Int     @default(1)
  episodeNumber Int
  name          String
  synopsis      String?
  videoPath     String
  durationSec   Int     @default(0)
  previewSec    Int     @default(0)
  sortOrder     Int     @default(0)

  progress     Progress[]
  subtitles    Subtitle[]
  transcodeJob TranscodeJob?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([titleId, seasonNumber, episodeNumber])
  @@index([titleId])
}

model Subtitle {
  id        String  @id @default(cuid())
  episodeId String
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  lang      String // e.g. "tr", "en"
  label     String // display name, e.g. "Türkçe"
  vttPath   String // storage key or URL to the WebVTT file

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([episodeId, lang])
  @@index([episodeId])
}

model Instructor {
  id       String  @id @default(cuid())
  name     String
  bio      String?
  photoUrl String?
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Set when a company created this instructor in its content studio; such
  // instructors are only assignable to that org's own titles.
  createdByOrgId String?
  createdByOrg   Organization? @relation(fields: [createdByOrgId], references: [id], onDelete: Cascade)

  credits TitleInstructor[]

  @@index([createdByOrgId])
}

model TitleInstructor {
  titleId      String
  instructorId String
  role         String?
  title        Title      @relation(fields: [titleId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@id([titleId, instructorId])
  @@index([instructorId])
}

model Progress {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodeId   String
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  positionSec Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@id([userId, episodeId])
  @@index([userId, completedAt, updatedAt(sort: Desc)])
  @@index([episodeId])
}

model IndividualSubscription {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  plan                 String
  status               String
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  // Unix-time of the most recent Stripe event applied — guards against
  // out-of-order webhook redelivery overwriting newer state with older.
  lastEventAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Processed Stripe webhook event ids — idempotency / dedup of redelivered events.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

model CompanyProfile {
  organizationId        String       @id
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  billingEmail          String
  contactName           String?
  contactPhone          String?
  seatCount             Int          @default(0)
  // "pending" | "active" | "grace" | "expired"
  subscriptionStatus    String       @default("pending")
  // Self-serve content studio: when true (default) the org owner can create
  // ORG_ONLY trainings for their own company from the corporate panel.
  selfServeContent      Boolean      @default(true)
  subscriptionStartedAt DateTime?
  subscriptionEndsAt    DateTime?
  notes                 String?

  // Stripe self-checkout (null for manually activated companies).
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // "corp_small" (max 10 seats) | "corp_large" (unlimited)
  plan                 String?
  cancelAtPeriodEnd    Boolean   @default(false)
  lastEventAt          DateTime?

  // Originating sales lead this company was activated from (if any).
  leadId String?        @unique
  lead   CorporateLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String

  messages AgentMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model AgentMessage {
  id             String            @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CorporateLead {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  seatTarget  Int?
  message     String?
  // "new" | "contacted" | "converted"
  status      String   @default("new")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company CompanyProfile?
}

// ---------------------------------------------------------------------------
// Background HLS transcode queue — consumed by the GitHub Actions worker
// (worker/index.mjs). One job per episode; re-uploads reuse the same row.
// ---------------------------------------------------------------------------

enum TranscodeStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model TranscodeJob {
  id        String          @id @default(cuid())
  episodeId String          @unique
  episode   Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  // Raw storage key the job was created for (uploads/…mp4). If the episode's
  // videoPath no longer matches, the job is stale and the worker skips it.
  sourceKey String
  status    TranscodeStatus @default(QUEUED)
  attempts  Int             @default(0)
  error     String?
  // Set when a worker claims the job; stale PROCESSING rows (crashed runner)
  // are reclaimed after a timeout.
  lockedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}
